<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Dictation and meeting notes: the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Commands: Spotify, Music, dark mode and the Trash through Apple Events. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Meeting names and attendees, events and reminders you ask for. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Contact names, so dictation spells them right. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
</dict>
</plist>
